# Local dev uses SQLite. For production, switch provider in prisma/schema.prisma to postgresql.
DATABASE_URL="file:./dev.db"
NEXT_PUBLIC_WHATSAPP_NUMBER=6281234567890
NEXT_PUBLIC_SITE_URL="https://www.beautiro.com"
# Optional: Meta (Facebook) Pixel for conversion tracking
NEXT_PUBLIC_META_PIXEL_ID=

# Customer accounts are stored in PostgreSQL (Neon) via Prisma User/Session models.
# Admin account (created/updated on db seed)
ADMIN_EMAIL="admin@beautiro.com"
ADMIN_PASSWORD="change-me-strong-password"

# Google OAuth (https://console.cloud.google.com/)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Transactional email via Resend (https://resend.com/)
RESEND_API_KEY=
EMAIL_FROM="Beautiro <noreply@beautiro.com>"
